# ==========================================
# CRY Configuration & LLM Provider
# ==========================================

# Generic OpenAI-compatible endpoint
# Cloud Mode (Groq): https://api.groq.com/openai/v1
# Active Groq Models: llama-3.1-8b-instant (30k+ TPM), qwen/qwen3.8-27b, openai/gpt-oss-20b, openai/gpt-oss-120b
# Local / Offline Mode (Ollama): http://localhost:11434/v1
CRY_LLM_BASE_URL=https://api.groq.com/openai/v1
CRY_LLM_API_KEY=your_api_key_here
CRY_LLM_MODEL=llama-3.1-8b-instant

# Prioritized fallback models pool (auto-switched if primary model hits API rate limits or 429)
CRY_LLM_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b,openai/gpt-oss-120b,llama-3.3-70b-versatile

# Cost calculation estimates (USD per 1M tokens)
CRY_COST_PER_M_PROMPT=0.59
CRY_COST_PER_M_COMPLETION=0.79

# Scan Settings
CRY_MAX_FILE_SIZE_MB=5
CRY_SCAN_TIMEOUT_SECONDS=300
CRY_LOG_LEVEL=INFO
